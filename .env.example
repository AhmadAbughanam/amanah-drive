# Local development values are shown below. For production (VPS) values, see
# the "Production" comment on each line that needs to change, and
# docs/DEPLOYMENT.md for the full picture. Copy this file to .env and fill in
# real values — .env is gitignored and must never be committed.

POSTGRES_DB=amanah_drive
POSTGRES_USER=amanah_drive
# Production: generate a fresh, unique secret. Do not reuse a development
# value. Example: `openssl rand -hex 24`
POSTGRES_PASSWORD=replace-with-a-strong-postgres-password

API_HTTP_PORT=8080
# Production: https://ahmadabughanam.com (must exactly match the public
# origin the browser sees, no trailing slash).
WEB_ORIGIN=http://localhost:3000
# Production: https://ahmadabughanam.com/api — this is baked into the web
# image at BUILD time (see docs/RELEASING.md), not read at container
# startup. Changing it later requires publishing a new web image.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# Server-only contact form delivery. In production, create a Resend API key
# with send-only access and verify ahmadabughanam.com before using this sender.
CONTACT_EMAIL_API_KEY=replace-with-a-resend-api-key
CONTACT_EMAIL_FROM="Ahmad Abughanam <contact@ahmadabughanam.com>"
# Production: update the password segment to match POSTGRES_PASSWORD above.
POSTGRES_CONNECTION_STRING=Host=postgres;Port=5432;Database=amanah_drive;Username=amanah_drive;Password=replace-with-a-strong-postgres-password
AUTH_JWT_ISSUER=AmanahDrive
AUTH_JWT_AUDIENCE=AmanahDrive
# Production: generate a fresh, unique secret, at least 32 characters.
# Example: `openssl rand -hex 32`
AUTH_JWT_SIGNING_KEY=replace-with-at-least-32-random-characters
# Production: generate a fresh, unique one-time secret, then use it once to
# bootstrap the admin account and treat it as burned afterward.
# Example: `openssl rand -hex 24`
AUTH_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
# Must stay true in production — the app is served over HTTPS there and the
# refresh cookie requires it.
AUTH_SECURE_COOKIES=true
API_LOG_RETENTION_FILES=14
API_LOG_FILE_SIZE_LIMIT_BYTES=26214400

# Production: generate a fresh, unique secret shared only between the api
# and ai-service containers. Example: `openssl rand -hex 24`
AI_SERVICE_TOKEN=replace-with-a-shared-ai-service-token
AI_SERVICE_BASE_URL=http://ai-service:8000
AI_SERVICE_PORT=8000
# Production: your real Hugging Face access token (created at
# https://huggingface.co/settings/tokens). Never commit this value.
HF_API_TOKEN=replace-with-a-hugging-face-api-token
HF_MODEL=openai/gpt-oss-20b

OTEL_TRACING_ENABLED=true
OTEL_EXPORTER_OTLP_GRPC_ENDPOINT=http://jaeger:4317
OTEL_EXPORTER_OTLP_HTTP_TRACES_ENDPOINT=http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_TIMEOUT_SECONDS=5
JAEGER_UI_PORT=16686
JAEGER_OTLP_GRPC_PORT=4317
JAEGER_OTLP_HTTP_PORT=4318
WEB_PORT=3000

# --- Production only (infra/docker-compose.prod.yml / Caddy) ---
# Not used in local development. Required when the prod override is applied.
DOMAIN=ahmadabughanam.com
WWW_DOMAIN=www.ahmadabughanam.com

# --- Production only (running published GHCR images — see docs/RELEASING.md) ---
# GHCR_OWNER=your-github-username-lowercase
# AMANAH_DRIVE_VERSION=main
