{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "LoggingFiles": {
    "DirectoryPath": "logs",
    "FileNamePrefix": "api-",
    "RetainedFileCountLimit": 30,
    "FileSizeLimitBytes": 26214400,
    "DefaultPageSize": 50,
    "MaxPageSize": 200
  },
  "AdminActivity": {
    "DefaultPageSize": 25,
    "MaxPageSize": 100
  },
  "AiPricing": {
    "Models": []
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Drive": {
    "StorageRoot": "storage",
    "MaxFileSizeBytes": 10485760,
    "DefaultPageSize": 50,
    "MaxPageSize": 100,
    "AllowedContentTypes": [
      "application/pdf",
      "text/markdown",
      "text/plain"
    ]
  },
  "AiService": {
    "BaseUrl": "http://ai-service:8000",
    "ServiceToken": "",
    "ChunkSize": 1000,
    "ChunkOverlap": 200,
    "WorkerEnabled": true,
    "WorkerPollSeconds": 5
  },
  "Search": {
    "TopK": 5,
    "ChatHistoryMessageLimit": 10,
    "SnippetLength": 300,
    "RateLimitPermitLimit": 20,
    "RateLimitWindowMinutes": 1,
    "ChatDefaultPageSize": 50,
    "ChatMaxPageSize": 100
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000"
    ]
  },
  "AllowedHosts": "*"
}
